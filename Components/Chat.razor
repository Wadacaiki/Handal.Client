@using Handal.Client.Models
@implements IDisposable
@inject ChatService ChatService
@inject UserService UserService
@inject AuctionPlatformService PlatformService

@code {
    [Parameter] public string AuctionId { get; set; } = string.Empty;

}

<div class="p-6 rounded-lg bg-gradient-to-br from-slate-800/60 to-slate-900/60 border border-white/10 mt-6">
    <h3 class="text-lg font-bold mb-4 bg-clip-text text-transparent bg-gradient-to-r from-amber-200 to-yellow-300">Чат аукциона</h3>

    <div class="max-h-80 overflow-auto mb-4 space-y-3 p-3 rounded bg-black/20 border border-white/5">
        @if (messages.Count == 0)
        {
            <div class="text-center text-white/50 py-8">
                Сообщений еще нет. Будьте первым, кто напишет!
            </div>
        }
        @foreach (var m in messages)
        {
            <div class="p-3 rounded-lg" style="background: @(m.AuthorId == UserService.CurrentUser?.Id ? "rgba(34, 197, 94, 0.1)" : "rgba(148, 163, 184, 0.05)"); border: 1px solid @(m.AuthorId == UserService.CurrentUser?.Id ? "rgba(34, 197, 94, 0.2)" : "rgba(148, 163, 184, 0.1)")">
                <div class="flex justify-between items-start mb-1">
                    <span class="text-sm font-semibold" style="color: @(m.AuthorId == UserService.CurrentUser?.Id ? "#10b981" : "#94a3b8")">@GetAuthorName(m)</span>
                    <span class="text-xs text-white/40">@m.SentAt.ToString("HH:mm")</span>
                </div>
                <div class="text-sm text-white/80 break-words">@m.Text</div>
            </div>
        }
    </div>

    @if (UserService.CurrentUser != null)
    {
        <div class="flex gap-2">
            <input @bind="text" 
                   class="flex-1 px-4 py-2 rounded-lg bg-white/10 border border-white/20 text-white placeholder-white/40 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400" 
                   placeholder="Напишите сообщение..." />
            <button class="px-6 py-2 rounded-lg font-semibold text-white transition-all"
                    style="background: linear-gradient(135deg, #EFD867 0%, #F4C430 100%); color: #0C0C0C;"
                    @onclick="Send">
                Отправить
            </button>
        </div>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="text-sm text-red-400 mt-2 p-2 rounded bg-red-900/20 border border-red-700/30">@Error</div>
        }
    }
    else
    {
        <div class="p-3 rounded-lg bg-white/5 border border-white/10 text-center text-white/70">
            <p class="mb-2">Чтобы писать сообщения, нужно войти</p>
            <AuthProtectedButton CssClass="px-4 py-1 rounded text-sm font-semibold" 
                              AuthMode="login"
                              GuestModeText="Войти"
                              style="background: rgba(239, 216, 103, 0.1); color: #EFD867; border: 1px solid rgba(239, 216, 103, 0.3);">
                Войти
            </AuthProtectedButton>
        </div>
    }
</div>

@code {
    private List<ChatMessage> messages = new();
    private string text = string.Empty;
    private string Error = string.Empty;

    protected override void OnInitialized()
    {
        UserService.OnAuthStateChanged += HandleAuthStateChanged;
    }

    public void Dispose()
    {
        UserService.OnAuthStateChanged -= HandleAuthStateChanged;
    }

    protected override void OnParametersSet()
    {
        LoadMessages();
    }

    private void HandleAuthStateChanged()
    {
        LoadMessages();
        InvokeAsync(StateHasChanged);
    }

    private void LoadMessages()
    {
        if (string.IsNullOrEmpty(AuctionId)) return;
        messages = ChatService.GetAuctionMessages(AuctionId);
    }

    private string GetAuthorName(ChatMessage m)
    {
        if (m.AuthorId == UserService.CurrentUser?.Id)
            return "Вы";

        var authorName = m.Author?.FullName;
        if (!string.IsNullOrWhiteSpace(authorName))
            return authorName;

        var author = UserService.GetUserById(m.AuthorId);
        if (!string.IsNullOrWhiteSpace(author?.FullName))
            return author.FullName;

        return "Пользователь";
    }

    private void Send()
    {
        Error = string.Empty;
        if (UserService.CurrentUser == null)
        {
            UserService.RequestLogin();
            return;
        }
        var (success, message, chatMessage) = ChatService.SendMessage(AuctionId, UserService.CurrentUser.Id, text);
        if (!success)
        {
            Error = message;
            return;
        }
        text = string.Empty;
        PlatformService.SaveState();
        LoadMessages();
        StateHasChanged();
    }
}

@inherits ComponentBase
<div class="group relative pb-6 rounded-3xl overflow-hidden cursor-pointer"
     @onmouseover="() => isHovered = true"
     @onmouseout="() => isHovered = false">
    <!-- Image -->
    <div class="relative h-72 overflow-hidden">
        <img src="@Image" alt="@Title" class="w-full h-full object-cover transition-transform duration-500 ease-out @(@isHovered ? "scale-110" : "")" />
        
        <!-- Gradient overlay -->
        <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(12,12,12,0.9), transparent 60%)"></div>
        
        <!-- Top badges -->
        <div class="absolute top-4 right-4">
            <AuthProtectedButton OnClick="ToggleFavorite"
                                RequireAuthentication="true"
                                AuthMode="login"
                                CssClass="@($"w-10 h-10 rounded-full backdrop-blur-xl flex items-center justify-center transition-all shadow-sm hover:scale-105 {(isLiked ? "bg-rose-900 text-amber-300" : "bg-black/50 text-white")}")"
                                aria-label="Добавить в избранное"
                                title="Добавить в избранное">
                <i class="lucide icon-heart"></i>
            </AuthProtectedButton>
        </div>
        
        <!-- Bottom info -->
        <div class="absolute bottom-4 left-4 right-4">
            <div class="flex items-center gap-2 mb-3">
                <div class="px-3 py-1 rounded-full text-xs font-semibold backdrop-blur-xl"
                     style="background: rgba(239,216,103,0.2); color: #EFD867; border: 1px solid rgba(239,216,103,0.3)">
                    @Category
                </div>
                <div class="flex items-center gap-1 px-3 py-1 rounded-full text-xs backdrop-blur-xl"
                     style="background: rgba(12,12,12,0.6); color: white; border: 1px solid rgba(255,255,255,0.1)" title="Просмотры">
                    <i class="lucide icon-eye"></i> @ViewsCount
                </div>
                <div class="flex items-center gap-1 px-3 py-1 rounded-full text-xs backdrop-blur-xl"
                     style="background: rgba(12,12,12,0.6); color: white; border: 1px solid rgba(255,255,255,0.1)" title="Комментарии">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                    @CommentsCount
                </div>
            </div>
        </div>
        
        <!-- Glow effect -->
        <div class="absolute inset-0 pointer-events-none"
             style="opacity: @(@isHovered ? "1" : "0"); background: radial-gradient(circle at 50% 0%, rgba(104,32,33,0.2), transparent 70%)"></div>
    </div>
    
    <!-- Content -->
    <div class="p-6 space-y-4 bg-slate-900/40">
        <!-- Title -->
        <h3 class="text-xl font-bold m-0 line-clamp-2 leading-tight" style="color: white;">
            @Title
        </h3>
        
        <!-- Bid info -->
        <div class="flex items-end justify-between">
            <div>
                <div class="text-xs mb-1 font-medium" style="color: white; opacity: 0.5;">
                    Текущая ставка
                </div>
                <div class="text-3xl font-black m-0" style="color: #EFD867; letter-spacing: -0.02em">
                    @CurrentBid.ToString("N0") ₸
                </div>
            </div>
            <div class="text-right">
                <div class="flex items-center gap-1 justify-end mb-1">
                    <i class="lucide icon-user" style="color: white; opacity: 0.5;"></i>
                    <span class="text-xs font-medium" style="color: white; opacity: 0.5">
                        @BidsCount ставок
                    </span>
                </div>
            </div>
        </div>
        
        <!-- Timer bar -->
        <div class="p-4 rounded-2xl relative overflow-hidden"
             style="background: linear-gradient(135deg, rgba(104,32,33,0.2) 0%, rgba(104,32,33,0.1) 100%); border: 1px solid rgba(104,32,33,0.3);">
            <div class="flex items-center justify-between relative z-10">
                <div class="flex items-center gap-2">
                    <div class="relative">
                        <i class="lucide icon-clock" style="color: #EFD867;"></i>
                    </div>
                    <span class="text-sm font-bold" style="color: #EFD867;">
                        @TimeLeft
                    </span>
                </div>
                <span class="text-xs" style="color: white; opacity: 0.5;">
                    до завершения
                </span>
            </div>
        </div>
        
        <!-- Action button -->
        <AuthProtectedButton CssClass="w-full py-4 rounded-2xl font-bold text-sm relative overflow-hidden group text-white shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all"
                            AuthMode="login"
                            GuestModeText="Войти для участия"
                            AuthenticatedText="Сделать ставку"
                            OnClick="HandleAuthenticatedClick"
                            style="background: linear-gradient(135deg, #ef4444 0%, #f97316 100%); border: 1px solid rgba(255,255,255,0.06);">
            <span class="relative z-10">
                @ButtonText
            </span>
        </AuthProtectedButton>
    </div>
</div>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Category { get; set; } = "";
    [Parameter] public decimal CurrentBid { get; set; }
    [Parameter] public string Image { get; set; } = "";
    [Parameter] public int BidsCount { get; set; }
    [Parameter] public int ViewsCount { get; set; } = 0;
    [Parameter] public int CommentsCount { get; set; } = 0;
    [Parameter] public bool IsFeatured { get; set; } = false;
    [Parameter] public bool IsCharity { get; set; } = false;
    [Parameter] public int CharityPercent { get; set; } = 0;
    [Parameter] public DateTime EndsAt { get; set; }
    [Parameter] public bool IsAuthenticated { get; set; } = false;

    [Parameter] public EventCallback<string?> OnCardClick { get; set; }

    private bool isHovered = false;
    private bool isLiked = false;
    private string buttonText = "Войти для участия";
    private string timeLeft = "Завершен";

    protected override void OnParametersSet()
    {
        // Button text determined by current auth state
        ButtonText = (UserService?.CurrentUser != null) ? "Сделать ставку" : "Войти для участия";
        UpdateTimeLeft();
    }

    private System.Threading.CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        UpdateTimeLeft();
        if (UserService != null)
            UserService.OnAuthStateChanged += OnAuthChanged;

        // Start periodic update with cancellation support
        _cts = new System.Threading.CancellationTokenSource();
        var token = _cts.Token;
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(1000, token);
                UpdateTimeLeft();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // expected on dispose
        }
    }

    private void OnAuthChanged()
    {
        ButtonText = (UserService?.CurrentUser != null) ? "Сделать ставку" : "Войти для участия";
        InvokeAsync(StateHasChanged);
    }

    private void UpdateTimeLeft()
    {
        var remaining = EndsAt - DateTime.Now;
        if (remaining.TotalSeconds <= 0)
        {
            TimeLeft = "Завершен";
        }
        else if (remaining.TotalHours >= 1)
        {
            TimeLeft = $"{Math.Floor(remaining.TotalHours)}ч {remaining.Minutes}м";
        }
        else if (remaining.TotalMinutes >= 1)
        {
            TimeLeft = $"{remaining.Minutes}м {remaining.Seconds}с";
        }
        else
        {
            TimeLeft = $"{remaining.Seconds}с";
        }
    }

    private string TimeLeft
    {
        get => timeLeft;
        set => timeLeft = value;
    }

    private string ButtonText
    {
        get => buttonText;
        set => buttonText = value;
    }

    [Inject] private UserService? UserService { get; set; }

    private void ToggleFavorite(MouseEventArgs args)
    {
        // AuthProtectedButton already handles authentication check
        isLiked = !isLiked;
    }

    private async Task ClickHandler()
    {
        if (UserService?.CurrentUser == null)
        {
            UserService?.RequestLogin();
            return;
        }
        await HandleAuthenticatedClick();
    }

    private async Task HandleAuthenticatedClick()
    {
        if (OnCardClick.HasDelegate)
        {
            await OnCardClick.InvokeAsync(Id);
        }
    }

    private void ShowAuthNotification()
    {
        // Backwards compatibility: request login modal
        UserService?.RequestLogin();
    }

    public void Dispose()
    {
        if (UserService != null)
            UserService.OnAuthStateChanged -= OnAuthChanged;
        try
        {
            _cts?.Cancel();
            _cts?.Dispose();
        }
        catch { }
    }
}

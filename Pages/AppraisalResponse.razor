@page "/appraisal-response"
@using Microsoft.AspNetCore.Components
@inject UserService UserService
@inject AuctionService AuctionService
@inject NotificationService NotificationService
@inject AuctionPlatformService PlatformService

<div class="min-h-screen bg-white py-12">
    <div class="container mx-auto px-4 lg:px-8 max-w-2xl">
        <div class="rounded-2xl border border-burgundy/10 p-8 shadow-xl">
            <h1 class="text-3xl font-black text-burgundy mb-4">Решение по оценке лота</h1>
            <p class="text-burgundy/70 mb-6">@ResultMessage</p>
            <a href="/notifications"
               class="inline-block px-6 py-3 rounded-xl bg-burgundy text-white font-bold hover:bg-burgundy/90 transition-colors">
                Перейти в уведомления
            </a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "auctionId")]
    public string? AuctionId { get; set; }

    [SupplyParameterFromQuery(Name = "decision")]
    public string? Decision { get; set; }

    private string ResultMessage { get; set; } = "Обрабатываем ваш ответ...";
    private bool _handled;

    protected override void OnParametersSet()
    {
        if (_handled)
            return;
        _handled = true;

        if (UserService.CurrentUser == null)
        {
            ResultMessage = "Чтобы подтвердить решение, войдите в аккаунт продавца и повторите переход по ссылке.";
            return;
        }

        if (string.IsNullOrWhiteSpace(AuctionId) || string.IsNullOrWhiteSpace(Decision))
        {
            ResultMessage = "Ссылка некорректна. Проверьте письмо и попробуйте снова.";
            return;
        }

        var auction = AuctionService.GetAuctionById(AuctionId);
        if (auction == null)
        {
            ResultMessage = "Лот не найден.";
            return;
        }

        if (!string.Equals(auction.SellerId, UserService.CurrentUser.Id, StringComparison.OrdinalIgnoreCase))
        {
            ResultMessage = "Этот лот принадлежит другому пользователю.";
            return;
        }

        if (Decision.Equals("accept", StringComparison.OrdinalIgnoreCase))
        {
            if (AuctionService.AcceptAppraisalBySeller(AuctionId, UserService.CurrentUser.Id))
            {
                NotificationService.CreateSystemNotification(
                    UserService.CurrentUser.Id,
                    "Оценка принята",
                    "Вы согласились с оценкой администратора. Лот ожидает финального одобрения.");
                NotificationService.CreateSystemNotification(
                    "admin-internal",
                    "Продавец согласился с оценкой",
                    $"Лот \"{auction.Title}\" готов к одобрению.");
                PlatformService.SaveState();
                ResultMessage = "Вы согласились с оценкой. Теперь лот можно одобрить в админ-панели.";
                return;
            }
        }
        else if (Decision.Equals("reject", StringComparison.OrdinalIgnoreCase))
        {
            if (AuctionService.RejectAppraisalBySeller(AuctionId, UserService.CurrentUser.Id))
            {
                NotificationService.CreateSystemNotification(
                    UserService.CurrentUser.Id,
                    "Оценка отклонена",
                    "Вы отказались от оценки. Лот автоматически перенесен в отклоненные.");
                NotificationService.CreateSystemNotification(
                    "admin-internal",
                    "Оценка отклонена продавцом",
                    $"Продавец отказался от оценки лота \"{auction.Title}\".");
                PlatformService.SaveState();
                ResultMessage = "Вы отказались от оценки. Лот автоматически отклонен и снят с модерации.";
                return;
            }
        }

        ResultMessage = "Не удалось применить решение. Возможно, по лоту уже принято другое действие.";
    }
}

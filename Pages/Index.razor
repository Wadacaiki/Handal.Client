                    <div>
                        <label class="block text-sm font-bold text-burgundy mb-2">Краткое описание</label>
                        <InputTextArea class="w-full px-4 py-3 rounded-xl bg-white border-2 border-burgundy/10 text-burgundy font-bold focus:border-yellow focus:outline-none transition-colors"
                                       maxlength="500" rows="4" @bind-Value="createModel.Description" />
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-bold text-burgundy mb-2">Категория</label>
                            <select class="w-full px-4 py-3 rounded-xl bg-white border-2 border-burgundy/10 text-burgundy font-bold focus:border-yellow focus:outline-none transition-colors"
                                    @bind="createModel.Category">
                                @foreach (var c in CategoriesOptions)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-burgundy mb-2">Стартовая цена</label>
                            <InputNumber class="w-full px-4 py-3 rounded-xl bg-white border-2 border-burgundy/10 text-burgundy font-bold focus:border-yellow focus:outline-none transition-colors"
                                         @bind-Value="createModel.StartPrice" />
                        </div>
                    </div>
                    <div class="p-4 rounded-xl bg-burgundy/5 border border-burgundy/10">
                        <div class="flex items-end gap-3 mb-3">
                            <div class="flex-1">
                                <label class="block text-sm font-bold text-burgundy mb-2">Тег</label>
                                <div class="relative">
                                    <InputText class="w-full px-4 py-3 rounded-xl bg-white border-2 border-burgundy/10 text-burgundy font-bold focus:border-yellow focus:outline-none transition-colors"
                                               @bind-Value="_tagInput" @oninput="OnTagInputChanged" />
                                    @if (_createSuggestions.Count > 0)
                                    {
                                        <div class="absolute z-20 bg-white border border-burgundy/10 rounded-xl mt-1 w-full max-h-60 overflow-auto shadow-lg">
                                            @foreach (var s in _createSuggestions)
                                            {
                                                <button type="button" class="w-full text-left px-3 py-2 hover:bg-burgundy/5" @onclick="() => SelectCreateSuggestion(s)">@s</button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            <button type="button" class="px-6 py-3 rounded-xl font-bold text-white bg-burgundy hover:bg-burgundy/90 transition-colors"
                                    @onclick="AddTagInput">
                                Добавить тег
                            </button>
                        </div>
                        @if (_createError != "")
                        {
                            <div class="mb-2 p-2 rounded-lg bg-red-500/10 border border-red-500/30 text-red-600 text-sm font-bold">@_createError</div>
                        }
                        @if (_tagItems.Count > 0)
                        {
                            <div class="flex flex-wrap gap-2">
                                @foreach (var t in _tagItems)
                                {
                                    <div class="flex items-center gap-2 px-3 py-1.5 rounded-full border text-sm @(t.Exists ? "border-green-300 bg-green-50 text-green-700" : "border-burgundy/20 bg-white text-burgundy")">
                                        <span>@t.Name</span>
                                        <button type="button" class="ml-1 text-burgundy/60 hover:text-burgundy" @onclick="() => RemoveTagItem(t)">×</button>
                                    </div>
                                }
                            </div>
                        }
                        <div class="text-xs text-burgundy/60 mt-2">Новые теги отправляются на модерацию. Одобренные ранее теги используются сразу, но их применение к лоту проверяется администратором.</div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-bold text-burgundy mb-2">Длительность аукциона</label>
                            <select class="w-full px-4 py-3 rounded-xl bg-white border-2 border-burgundy/10 text-burgundy font-bold focus:border-yellow focus:outline-none transition-colors"
                                    @bind="createModel.DurationHours">
                                @foreach (var h in DurationOptions)
                                {
                                    <option value="@h">@h ч</option>
                                }
                            </select>
                        </div>
                        <div class="flex items-center gap-3">
                            <input type="checkbox" id="charity" class="w-5 h-5" @bind="createIsCharitable" />
                            <label for="charity" class="text-burgundy font-bold">Благотворительный аукцион (10%)</label>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-burgundy mb-2">Фото товара (JPG/PNG, до 350 КБ)</label>
                        <InputFile OnChange="OnFileChange" accept=".jpg,.jpeg,.png" />
                        @if (!string.IsNullOrEmpty(PreviewImage))
                        {
                            <img src="@PreviewImage" alt="preview" class="mt-3 w-full h-60 object-cover rounded-xl border border-burgundy/10" />
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(CreateError))
                    {
                        <div class="p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-600 font-bold text-sm">@CreateError</div>
                    }
                    <div class="flex items-center justify-end gap-3 pt-2">
                        <button type="button" class="px-6 py-3 rounded-xl font-bold text-burgundy/70 hover:text-burgundy hover:bg-burgundy/5 transition-colors"
                                @onclick="() => ShowCreateModal = false">
                            Отмена
                        </button>
                        <button type="submit" class="px-8 py-3 rounded-xl font-bold text-white shadow-lg hover:shadow-yellow/20 transform hover:-translate-y-0.5 transition-all"
                                style="background-color: #682021;">
                            Отправить на рассмотрение
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private const long MaxAuctionImageBytes = 350 * 1024;
    private List<Auction> allAuctions = new();
    private string? selectedCategory;
    private string? hoveredCategory;
    private bool ShowCreateModal = false;
    private List<CategorySalesStat> currentStats = new();
    private SalesPeriod selectedSalesPeriod = SalesPeriod.Month;
    private string _filterTagInput = string.Empty;
    private List<string> _filterSuggestions = new();
    private HashSet<string> _selectedFilterTags = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, int> _relevance = new();
    private string _lotSearchQuery = string.Empty;
    private bool _matchAllSelectedTags = false;
    private string _sortMode = "relevance";

    private void UpdateStats(SalesPeriod period)
    {
        selectedSalesPeriod = period;
        currentStats = BuildCategorySalesStats(period);
        StateHasChanged();
    }
    private string? PreviewImage;
    private string CreateError = string.Empty;
    private CreateAuctionModel createModel = new();
    private bool createIsCharitable = false;
    private readonly string[] CategoriesOptions = new[] { "Часы", "Антиквариат", "Книги", "Искусство", "Украшения", "Этнос", "Мебель", "История", "Музыка", "Оружие" };
    private readonly int[] DurationOptions = new[] { 1, 3, 6, 12, 18, 23 };
    private readonly Dictionary<string, string> _categoryColors = new()
    {
        ["Часы"] = "#682021",
        ["Антиквариат"] = "#8b2d2e",
        ["Книги"] = "#a43a3c",
        ["Искусство"] = "#bf4a4c",
        ["Украшения"] = "#d55c5e",
        ["Этнос"] = "#e47b57",
        ["Мебель"] = "#ef9c5e",
        ["История"] = "#efd867",
        ["Музыка"] = "#93c5fd",
        ["Оружие"] = "#60a5fa"
    };

    private List<Auction> FilteredAuctions
    {
        get
        {
            var query = allAuctions.AsEnumerable();

            if (!string.IsNullOrEmpty(selectedCategory))
                query = query.Where(a => a.Category == selectedCategory);

            if (!string.IsNullOrWhiteSpace(_lotSearchQuery))
            {
                var search = _lotSearchQuery.Trim();
                query = query.Where(a =>
                    a.Title.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    a.Description.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    a.Category.Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            var list = ApplyTagFilterIfAny(query.ToList());
            return SortAuctions(list);
        }
    }

    private List<Auction> ApplyTagFilterIfAny(List<Auction> baseList)
    {
        if (_selectedFilterTags.Count == 0)
            return baseList;
        var filtered = Platform.TagService.FilterAuctionsByTags(_selectedFilterTags.ToList(), out _relevance, _matchAllSelectedTags);
        var allowedIds = baseList.Select(a => a.Id).ToHashSet();
        filtered = filtered.Where(a => allowedIds.Contains(a.Id)).ToList();
        return filtered;
    }

    private List<Auction> SortAuctions(List<Auction> auctions)
    {
        return _sortMode switch
        {
            "newest" => auctions.OrderByDescending(a => a.StartedAt).ToList(),
            "price_desc" => auctions.OrderByDescending(a => a.CurrentBid).ToList(),
            "price_asc" => auctions.OrderBy(a => a.CurrentBid).ToList(),
            "popular" => auctions.OrderByDescending(a => a.ViewsCount).ThenByDescending(a => a.BidsCount).ToList(),
            _ => auctions
                .OrderByDescending(a => _relevance.TryGetValue(a.Id, out var score) ? score : 0)
                .ThenByDescending(a => a.ViewsCount)
                .ToList()
        };
    }

    private void FilterBy(string? category)
    {
        selectedCategory = category;
        StateHasChanged();
    }
    private void UpdateTagSuggestions(ChangeEventArgs _)
    {
        _filterSuggestions = Platform.TagService.GetAutocompleteSuggestions(_filterTagInput, limit: 8, minUsage: 0);
    }
    private void HandleFilterTagInputKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddFilterTag(_filterTagInput);
        }
    }
    private void AddFilterTag(string tag)
    {
        if (string.IsNullOrWhiteSpace(tag)) return;
        _selectedFilterTags.Add(tag.Trim());
        _filterTagInput = string.Empty;
        _filterSuggestions.Clear();
    }
    private void RemoveFilterTag(string tag)
    {
        _selectedFilterTags.Remove(tag);
    }
    private void ApplyTagFilter()
    {
        if (!string.IsNullOrWhiteSpace(_filterTagInput))
        {
            AddFilterTag(_filterTagInput);
        }

        Platform.TagService.RecordTagQuery(_selectedFilterTags);
        allAuctions = Platform.AuctionService.GetActiveAuctions();
        StateHasChanged();
    }
    private void ClearAllFilters()
    {
        _lotSearchQuery = string.Empty;
        _filterTagInput = string.Empty;
        _filterSuggestions.Clear();
        _selectedFilterTags.Clear();
        _relevance.Clear();
        _matchAllSelectedTags = false;
        _sortMode = "relevance";
        selectedCategory = null;
        allAuctions = Platform.AuctionService.GetActiveAuctions();
        StateHasChanged();
    }
    private void SetTagMatchMode(bool matchAll)
    {
        _matchAllSelectedTags = matchAll;
        StateHasChanged();
    }
    private string GetFilterModeClass(bool matchAll) =>
        $"px-5 py-3 rounded-2xl font-bold border-2 transition-colors {(matchAll == _matchAllSelectedTags ? "bg-burgundy text-white border-burgundy" : "bg-white text-burgundy border-burgundy/10")}";
    private List<string> GetSearchDiscoveryTags() =>
        Platform.TagService.GetTrendingTags(minUsage: 0, top: 10).Select(t => t.Name).ToList();
    private List<string> GetAuctionPreviewTags(string auctionId) =>
        Platform.TagService.GetApprovedTagNamesForAuction(auctionId).Take(4).ToList();
    private async Task SaveCurrentFilterSet()
    {
        if (UserService.CurrentUser == null || _selectedFilterTags.Count == 0) return;
        var name = $"Набор {DateTime.Now:HH:mm}";
        UserService.CurrentUser.SavedTagFilters ??= new();
        UserService.CurrentUser.SavedTagFilters.Add(new SavedTagFilterSet
        {
            Name = name,
            Tags = _selectedFilterTags.ToList(),
            CreatedAt = DateTime.Now
        });
        Platform.SaveState();
        await Task.Yield();
    }
    private void ApplySavedFilterSet(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (string.IsNullOrEmpty(id) || UserService.CurrentUser?.SavedTagFilters == null) return;
        var set = UserService.CurrentUser.SavedTagFilters.FirstOrDefault(s => s.Id == id);
        if (set == null) return;
        _selectedFilterTags = new HashSet<string>(set.Tags ?? new List<string>(), StringComparer.OrdinalIgnoreCase);
        ApplyTagFilter();
    }

    // Новый метод для обработки нажатия на кнопку "Начать сейчас"
    private void HandleStartNowClick()
    {
        if (UserService.CurrentUser == null)
        {
            UserService.RequestLogin();
        }
        else
        {
            // Если пользователь авторизован, открываем модалку создания лота
            OpenCreateAuction();
        }
    }

    private void OpenCreateAuction()
    {
        CreateError = string.Empty;
        createIsCharitable = false;
        ShowCreateModal = true;
    }

    protected override void OnInitialized()
    {
        allAuctions = Platform.AuctionService.GetActiveAuctions();
        currentStats = BuildCategorySalesStats(selectedSalesPeriod);
        UserService.OnAuthStateChanged += StateHasChanged;

        var uri = new Uri(Nav.Uri);
        var query = uri.Query.TrimStart('?');
        if (!string.IsNullOrWhiteSpace(query))
        {
            var queryParams = query.Split('&', StringSplitOptions.RemoveEmptyEntries)
                .Select(part => part.Split('=', 2))
                .Where(parts => parts.Length == 2)
                .ToDictionary(parts => Uri.UnescapeDataString(parts[0]), parts => Uri.UnescapeDataString(parts[1]));

            if (queryParams.TryGetValue("tag", out var tag) && !string.IsNullOrWhiteSpace(tag))
            {
                AddFilterTag(tag);
                ApplyTagFilter();
            }
        }
    }

    public void Dispose()
    {
        UserService.OnAuthStateChanged -= StateHasChanged;
    }

    private string FormatTimeRemaining(TimeSpan time)
    {
        if (time.TotalSeconds < 0)
            return "Завершен";

        if (time.TotalDays >= 1)
            return $"{(int)time.TotalDays}д {time.Hours}ч";

        if (time.TotalHours >= 1)
            return $"{(int)time.TotalHours}ч {time.Minutes}м";

        return $"{time.Minutes}м";
    }

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        CreateError = string.Empty;
        var file = e.File;
        if (file == null) return;
        if (file.Size > MaxAuctionImageBytes)
        {
            CreateError = "Размер файла превышает 350 КБ. Выберите более сжатое изображение.";
            return;
        }
        var buffer = new byte[(int)file.Size];
        await file.OpenReadStream(maxAllowedSize: MaxAuctionImageBytes).ReadAsync(buffer);
        var base64 = Convert.ToBase64String(buffer);
        var ext = file.ContentType; // image/jpeg or image/png
        PreviewImage = $"data:{ext};base64,{base64}";
        createModel.ImageDataUrl = PreviewImage;
    }

    private async Task SubmitCreate()
    {
        CreateError = string.Empty;
        if (UserService.CurrentUser == null)
        {
            UserService.RequestLogin();
            return;
        }

        // Проверка на ограничения от админа
        if (UserService.CurrentUser.IsRestricted)
        {
            CreateError = UserService.CurrentUser.RestrictionMessage ?? "Ваш доступ временно ограничен администрацией.";
            return;
        }

        if (string.IsNullOrWhiteSpace(createModel.Title) || string.IsNullOrWhiteSpace(createModel.Description))
        {
            CreateError = "Заполните название и описание";
            return;
        }
        if (string.IsNullOrEmpty(createModel.ImageDataUrl))
        {
            CreateError = "Добавьте фото товара";
            return;
        }
        if (createModel.StartPrice <= 0)
        {
            CreateError = "Стартовая цена должна быть больше 0";
            return;
        }
        foreach (var t in _tagItems)
        {
            var validationError = Platform.TagService.ValidateTagDraft(
                UserService.CurrentUser.Id,
                t.Name,
                _tagItems.Where(x => !ReferenceEquals(x, t)).Select(x => x.Name));
            if (!string.IsNullOrWhiteSpace(validationError))
            {
                CreateError = $"Ошибка в теге \"{t.Name}\": {validationError}";
                return;
            }
        }
        var category = string.IsNullOrWhiteSpace(createModel.Category) ? "Антиквариат" : createModel.Category;
        var auction = Platform.AuctionService.CreateAuction(
            UserService.CurrentUser.Id,
            createModel.Title,
            createModel.Description,
            category,
            createModel.StartPrice,
            TimeSpan.FromHours(createModel.DurationHours <= 0 ? 6 : createModel.DurationHours),
            createModel.ImageDataUrl!,
            isFeatured: false,
            isCharitable: createIsCharitable,
            charityPercent: createIsCharitable ? 10 : 0,
            seller: UserService.CurrentUser
        );
        foreach (var t in _tagItems)
        {
            Platform.TagService.AttachTagToAuction(UserService.CurrentUser.Id, auction.Id, t.Name, category);
        }

        // Уведомления
        Platform.NotificationService.NotifyAuctionCreated(UserService.CurrentUser.Id, auction.Title);
        Platform.NotificationService.NotifyAdminNewAuction(UserService.CurrentUser.FullName, auction.Title);

        // Отправка на почту администратору
        try
        {
            await Platform.EmailService.SendEmailAsync(
                "Handal Platform", // Имя отправителя
                "leraborovik2008@gmail.com",
                "Новый лот на рассмотрение",
                $"Пользователь {UserService.CurrentUser.FullName} отправил товар \"{auction.Title}\" на рассмотрение.");
        }
        catch { /* Игнорируем ошибки почты в демо */ }

        Platform.SaveState();
        allAuctions = Platform.AuctionService.GetActiveAuctions();
        ShowCreateModal = false;
        PreviewImage = null;
        createIsCharitable = false;
        createModel = new();
        _tagItems.Clear();
        _tagInput = string.Empty;
        StateHasChanged();
    }

    private class CreateAuctionModel
    {
        [Required, MaxLength(100)]
        public string Title { get; set; } = string.Empty;
        [Required, MaxLength(500)]
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = "Антиквариат";
        [Range(1, double.MaxValue)]
        public decimal StartPrice { get; set; } = 100;
        public int DurationHours { get; set; } = 6;
        public bool IsCharitable { get; set; } = false;
        public string? ImageDataUrl { get; set; }
    }

    private string _tagInput = string.Empty;
    private List<TagInputItem> _tagItems = new();
    private List<string> _createSuggestions = new();
    private string _createError = string.Empty;
    private void AddTagInput()
    {
        var name = Platform.TagService.CanonicalizeTagName(_tagInput ?? string.Empty);
        _createError = string.Empty;
        if (string.IsNullOrWhiteSpace(name)) { _createSuggestions.Clear(); return; }
        if (_tagItems.Count >= 10) { _createError = "Достигнут лимит тегов (10)"; return; }
        var validationError = Platform.TagService.ValidateTagDraft(
            UserService.CurrentUser?.Id ?? string.Empty,
            name,
            _tagItems.Select(x => x.Name));
        if (!string.IsNullOrWhiteSpace(validationError))
        {
            _createError = validationError;
            return;
        }
        var exists = Platform.TagService.HasApprovedDefinition(name);
        _tagItems.Add(new TagInputItem { Name = name, Exists = exists });
        _tagInput = string.Empty;
        _createSuggestions.Clear();
    }
    private void RemoveTagItem(TagInputItem item)
    {
        _tagItems.Remove(item);
    }
    private void SelectCreateSuggestion(string s)
    {
        _tagInput = s;
        AddTagInput();
    }
    private void OnTagInputChanged(ChangeEventArgs e)
    {
        _tagInput = e.Value?.ToString() ?? string.Empty;
        _createSuggestions = Platform.TagService.GetAutocompleteSuggestions(_tagInput, limit: 8, minUsage: 0);
    }
    private sealed class TagInputItem
    {
        public string Name { get; set; } = string.Empty;
        public bool Exists { get; set; }
    }

    private List<CategorySalesStat> BuildCategorySalesStats(SalesPeriod period)
    {
        var multiplier = period == SalesPeriod.Month ? 1000 : 16000;

        // 1. Получаем реальную историю всех завершенных аукционов из сервиса
        var realHistory = Platform.AuctionService.GetAllHistory()
            .Where(h => h.FinalStatus == AuctionStatus.Completed)
            .ToList();

        // 2. Группируем реальную историю по категориям
        var realGrouped = realHistory
            .GroupBy(h => string.IsNullOrWhiteSpace(h.Auction?.Category) ? "Антиквариат" : h.Auction!.Category)
            .ToDictionary(
                g => g.Key,
                g => new
                {
                    Count = g.Count(),
                    Total = g.Sum(x => x.FinalPrice),
                    Max = g.Max(x => x.FinalPrice)
                });

        var stats = new List<CategorySalesStat>();

        foreach (var category in CategoriesOptions)
        {
            // Используем хеш названия категории для детерминированного рандома (базовая системная статистика)
            var seed = category.GetHashCode() + (period == SalesPeriod.Month ? 1 : 2);
            var rnd = new Random(seed);

            // Базовые системные показатели
            int systemCount = rnd.Next(2, 5) * multiplier;

            decimal baseAvgPrice = category switch
            {
                "Искусство" => 85000m,
                "Украшения" => 45000m,
                "Оружие" => 62000m,
                "Часы" => 28000m,
                "Антиквариат" => 35000m,
                "Книги" => 12000m,
                "Этнос" => 22000m,
                "Мебель" => 48000m,
                "История" => 31000m,
                "Музыка" => 18000m,
                _ => 25000m
            };
            baseAvgPrice = baseAvgPrice * (decimal)(0.9 + rnd.NextDouble() * 0.2);

            // 3. Добавляем реальный вклад пользователя к системным данным
            int userSalesCount = 0;
            decimal userTotalSales = 0;
            decimal userMaxPrice = 0;

            if (realGrouped.TryGetValue(category, out var realData))
            {
                // Каждый завершенный лот пользователя вносит вклад, умноженный на коэффициент масштаба
                userSalesCount = realData.Count * (multiplier / 10); // Масштабируем вклад пользователя
                userTotalSales = realData.Total * (multiplier / 10);
                userMaxPrice = realData.Max;
            }

            int finalSalesCount = systemCount + userSalesCount;
            decimal finalTotalSales = (systemCount * baseAvgPrice) + userTotalSales;
            decimal finalAvgPrice = finalSalesCount > 0 ? finalTotalSales / finalSalesCount : baseAvgPrice;
            decimal finalMaxPrice = Math.Max(baseAvgPrice * (decimal)(2.5 + rnd.NextDouble() * 5.0), userMaxPrice);

            stats.Add(new CategorySalesStat
            {
                Category = category,
                SalesCount = finalSalesCount,
                TotalSales = finalTotalSales,
                AveragePrice = Math.Round(finalAvgPrice, 0),
                MaxPrice = Math.Round(finalMaxPrice, 0)
            });
        }

        var totalVolume = stats.Sum(s => s.TotalSales);
        foreach (var stat in stats)
        {
            stat.SharePercent = totalVolume > 0 ? Math.Round(stat.TotalSales / totalVolume * 100m, 2) : 0;
        }

        return stats.OrderByDescending(s => s.SalesCount).ToList();
    }

    private string GetCategoryColor(string category)
    {
        return _categoryColors.TryGetValue(category, out var color) ? color : "#682021";
    }

    private string BuildPieGradient(List<CategorySalesStat> stats)
    {
        var active = stats.Where(s => s.SharePercent > 0).OrderByDescending(s => s.SharePercent).ToList();
        if (active.Count == 0)
            return "conic-gradient(#f3f4f6 0 100%)";

        var parts = new List<string>();
        decimal current = 0;
        foreach (var stat in active)
        {
            var next = current + stat.SharePercent;
            parts.Add($"{GetCategoryColor(stat.Category)} {current.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}% {next.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%");
            current = next;
        }
        if (current < 100)
        {
            parts.Add($"#f3f4f6 {current.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}% 100%");
        }
        return $"conic-gradient({string.Join(", ", parts)})";
    }

    private enum SalesPeriod
    {
        Month,
        Year
    }

    private sealed class CategorySalesStat
    {
        public string Category { get; set; } = string.Empty;
        public int SalesCount { get; set; }
        public decimal TotalSales { get; set; }
        public decimal AveragePrice { get; set; }
        public decimal MaxPrice { get; set; }
        public decimal SharePercent { get; set; }
    }

@page "/history"
@inject UserService UserService
@inject AuctionService AuctionService

<div class="min-h-screen bg-white py-12">
    <div class="container mx-auto px-4 lg:px-8">
        
        <!-- Заголовок -->
        <div class="mb-12">
            <h1 class="text-4xl font-black text-burgundy mb-2">История торгов</h1>
            <p class="text-lg text-burgundy/70">Просмотр завершённых аукционов и ваших покупок</p>
        </div>

        @if (UserService.CurrentUser is null)
        {
            <div class="bg-white rounded-3xl p-12 text-center border border-burgundy/10 shadow-xl shadow-burgundy/5 max-w-2xl mx-auto">
                <div class="w-20 h-20 rounded-full bg-burgundy/5 text-burgundy flex items-center justify-center text-3xl mx-auto mb-6"></div>
                <p class="text-burgundy text-xl mb-8 font-medium">Вы не вошли в систему.</p>
                <a href="/" class="inline-block px-8 py-4 rounded-xl bg-burgundy text-white font-bold hover:bg-burgundy/90 transition-colors shadow-lg shadow-burgundy/20">
                    Вернуться на главную
                </a>
            </div>
        }
        else
        {
            var history = AuctionService.GetAllHistory()
                .Where(h => (h.WinnerId == UserService.CurrentUser.Id) || (h.SellerId == UserService.CurrentUser.Id) || (h.ParticipantIds.Contains(UserService.CurrentUser.Id)))
                .OrderByDescending(h => h.CompletedAt)
                .ToList();

            @if (!history.Any())
            {
                <div class="bg-white rounded-3xl p-12 text-center border border-burgundy/10 shadow-xl shadow-burgundy/5">
                    <div class="w-20 h-20 rounded-full bg-yellow/20 text-yellow-600 flex items-center justify-center text-3xl mx-auto mb-6"></div>
                    <p class="text-burgundy text-xl font-medium mb-6">У вас пока нет завершённых торгов.</p>
                    <a href="/" class="inline-block px-8 py-4 rounded-xl bg-burgundy text-white font-bold hover:bg-burgundy/90 transition-colors shadow-lg shadow-burgundy/20">
                        Перейти к аукционам
                    </a>
                </div>
            }
            else
            {
                <div class="space-y-6">
                    @foreach (var item in history)
                    {
                        <div class="bg-white rounded-2xl p-6 border border-burgundy/10 shadow-sm transition-all hover:shadow-md hover:-translate-y-1">
                            <div class="flex flex-col md:flex-row gap-6 md:items-center justify-between">
                                <div class="flex-1">
                                    <h3 class="text-2xl font-bold text-burgundy mb-2">
                                        @(item.Auction?.Title ?? "Аукцион")
                                    </h3>
                                    <div class="flex items-center gap-3 mb-2">
                                        @if (item.SellerId == UserService.CurrentUser.Id)
                                        {
                                            <span class="px-3 py-1 rounded-full bg-yellow/20 text-yellow-800 text-sm font-bold border border-yellow/30">
                                                Вы продали
                                            </span>
                                        }
                                        else if (item.WinnerId == UserService.CurrentUser.Id)
                                        {
                                            <span class="px-3 py-1 rounded-full bg-burgundy/10 text-burgundy text-sm font-bold border border-burgundy/20">
                                                Вы купили
                                            </span>
                                        }
                                        else if (item.ParticipantIds.Contains(UserService.CurrentUser.Id))
                                        {
                                            <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-600 text-sm font-bold border border-gray-200">
                                                Завершено
                                            </span>
                                        }
                                    </div>
                                    <p class="text-sm text-burgundy/50 font-medium">
                                        Завершён: @item.CompletedAt.ToString("g")
                                    </p>
                                </div>
                                <div class="text-left md:text-right bg-burgundy/5 md:bg-transparent p-4 md:p-0 rounded-xl">
                                    <div class="text-3xl font-black text-burgundy mb-1">
                                        @item.FinalPrice.ToString("N0") гроши
                                    </div>
                                    <div class="text-sm text-burgundy/60 font-medium">
                                        @if (item.SellerId == UserService.CurrentUser.Id)
                                        {
                                            <text>Ваш доход: <span class="text-burgundy font-bold">@item.SellerProceeds.ToString("N0") гроши</span></text>
                                        }
                                        else if (item.WinnerId == UserService.CurrentUser.Id)
                                        {
                                            <text>Сумма сделки</text>
                                        }
                                        else
                                        {
                                            <text>Лот завершён</text>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        // Подписка на изменения для обновления истории
        UserService.OnAuthStateChanged += OnAuthChanged;
    }

    private void OnAuthChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UserService.OnAuthStateChanged -= OnAuthChanged;
    }
}

